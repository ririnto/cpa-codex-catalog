{
  "name": "cpa-codex-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "run-p check:*",
    "check:go": "go tool task check",
    "check:lint-rules": "node --test rules/*.test.ts",
    "check:markdownlint-cli2": "markdownlint-cli2",
    "check:typescript": "tsc --noEmit",
    "check:ultracite": "ultracite check",
    "fix": "run-p fix:*",
    "fix:go": "go tool task fmt",
    "fix:markdownlint-cli2": "markdownlint-cli2 --fix",
    "fix:ultracite": "ultracite fix",
    "pre-commit": "run-s check",
    "pre-push": "run-s check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "catalog:",
    "@types/node": "catalog:",
    "husky": "catalog:",
    "markdownlint": "catalog:",
    "markdownlint-cli2": "catalog:",
    "npm-run-all2": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.11.2"
}
